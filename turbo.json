{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "//#lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "//#format": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format:fix": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },
    "//#knip": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:unit": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    }
  }
}
