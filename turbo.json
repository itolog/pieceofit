{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "//#quality": {
      "dependsOn": ["//#quality:lint", "//#quality:format"]
    },
    "//#quality:lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "//#quality:format": {},
    "//#quality:fix": {
      "dependsOn": ["//#fix:format"]
    },
    "//#fix:lint": {
      "cache": false
    },
    "//#fix:format": {
      "dependsOn": ["//#fix:lint"],
      "cache": false
    },
    "//#knip": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!CLAUDE.md"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:unit": {
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!CLAUDE.md"]
    }
  }
}
