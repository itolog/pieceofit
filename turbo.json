{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "//#quality": {
      "dependsOn": ["//#quality:lint", "//#quality:format"]
    },
    "//#quality:lint": {},
    "//#quality:format": {},
    "//#quality:fix": {
      "dependsOn": ["//#fix:lint", "//#fix:format"]
    },
    "//#fix:lint": {
      "cache": false
    },
    "//#fix:format": {
      "dependsOn": ["//#fix:lint"],
      "cache": false
    },
    "//#check-unused": {},
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {}
  }
}
