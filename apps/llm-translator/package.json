{
  "name": "llm-translator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.tsx",
  "scripts": {
    "start": "bun src/index.tsx",
    "dev": "bun --watch src/index.tsx",
    "build": "bun build src/index.tsx --compile --minify --outfile dist/llm-translator",
    "lint": "conc --timings -c \"auto\" \"bun:lint:*\"",
    "lint:code": "oxlint",
    "lint:types": "tsc --noEmit",
    "lint:unused": "knip",
    "lint:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix",
    "format": "oxfmt --write .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "conc --timings -c \"auto\" \"bun run lint\" \"bun run test\""
  },
  "dependencies": {
    "@langchain/core": "1.2.4",
    "@langchain/ollama": "1.3.0",
    "ink": "7.1.1",
    "ink-gradient": "4.0.1",
    "ink-select-input": "6.2.0",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "react": "19.2.8",
    "react-devtools-core": "file:./stubs/react-devtools-core",
    "ts-pattern": "5.9.0"
  },
  "devDependencies": {
    "@pieceofit/oxfmt-config": "*",
    "@pieceofit/oxlint-config": "*",
    "@pieceofit/typescript-config": "*",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "catalog:",
    "happy-dom": "20.11.1",
    "ink-testing-library": "4.0.0",
    "knip": "6.31.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
