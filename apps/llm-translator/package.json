{
  "name": "llm-translator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.tsx",
  "scripts": {
    "start": "bun src/index.tsx",
    "dev": "bun --watch src/index.tsx",
    "build": "bun build src/index.tsx --compile --minify --outfile dist/llm-translator",
    "check-types": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit-watch": "vitest",
    "test:unit-coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@langchain/core": "1.2.12",
    "@langchain/ollama": "1.3.0",
    "ink": "7.1.1",
    "ink-gradient": "4.0.1",
    "ink-select-input": "6.2.0",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "react": "19.3.0",
    "react-devtools-core": "file:./stubs/react-devtools-core",
    "ts-pattern": "5.9.0"
  },
  "devDependencies": {
    "@pieceofit/oxfmt-config": "workspace:*",
    "@pieceofit/oxlint-config": "workspace:*",
    "@pieceofit/typescript-config": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "happy-dom": "20.14.5",
    "ink-testing-library": "4.0.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "5.0.1"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
