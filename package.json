{
  "name": "pieceofit",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "oxfmt": "0.61.0",
      "oxlint": "1.76.0",
      "typescript": "7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "quality:lint": "oxlint .",
    "quality:format": "oxfmt --check .",
    "fix": "turbo run quality:fix",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt --write .",
    "check": "turbo run quality",
    "check-types": "turbo run check-types",
    "check-unused": "knip",
    "verify": "turbo run quality check-types test:unit check-unused",
    "test:unit": "turbo run test:unit",
    "deps:audit": "bun audit",
    "deps:outdated": "bun outdated --filter='*'",
    "deps:update": "bun update -r -i",
    "deps:reinstall": "rm -rf node_modules bun.lock && bun install"
  },
  "devDependencies": {
    "@pieceofit/oxfmt-config": "workspace:*",
    "@pieceofit/oxlint-config": "workspace:*",
    "knip": "6.31.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "2.10.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "engines": {
    "bun": "1.3.14",
    "node": "24.18.1"
  }
}
