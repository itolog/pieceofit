{
  "name": "pieceofit",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "concurrently": "10.0.4",
      "oxfmt": "0.61.0",
      "oxlint": "1.76.0",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "fix:lint": "turbo run fix:lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "deps:audit": "bun audit",
    "deps:outdated": "bun outdated --filter='*'",
    "deps:update": "bun update -r -i",
    "deps:reinstall": "rm -rf node_modules bun.lock && bun install"
  },
  "devDependencies": {
    "turbo": "2.10.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "engines": {
    "bun": "1.3.14",
    "node": "24.18.1"
  }
}
