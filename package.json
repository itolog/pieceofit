{
  "name": "pieceofit",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "oxfmt": "0.64.0",
      "oxlint": "1.79.0",
      "typescript": "7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "fix": "turbo run lint:fix format:fix",
    "lint:fix": "oxlint --fix .",
    "format:fix": "oxfmt --write .",
    "check": "turbo run lint format",
    "check-types": "turbo run check-types",
    "knip": "knip",
    "check-unused": "turbo run knip",
    "verify": "turbo run lint format check-types test:unit knip",
    "test:unit": "turbo run test:unit",
    "deps:audit": "bun audit",
    "deps:outdated": "bun outdated --filter='*'",
    "deps:update": "bun update -r -i",
    "deps:reinstall": "rm -rf node_modules apps/*/node_modules packages/*/node_modules && bun install",
    "deps:reset": "rm -f bun.lock && bun run deps:reinstall"
  },
  "devDependencies": {
    "@pieceofit/oxfmt-config": "workspace:*",
    "@pieceofit/oxlint-config": "workspace:*",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "2.10.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "engines": {
    "bun": "1.3.14",
    "node": "24.18.1"
  }
}
